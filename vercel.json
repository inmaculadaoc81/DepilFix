{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/:wp(.*-sitemap\\d*\\.xml)",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/((?!(?:detalle-reparacion\\.jpg|apple-touch-icon\\.png|detalle-reparacion|hero-depilfix\\.jpg|logo-depilfix\\.png|apple-touch-icon|isotype-512\\.png|favicon-32\\.png|favicon-64\\.png|hero-depilfix|logo-depilfix|og-image\\.jpg|package\\.json|isotype-512|sitemap\\.xml|favicon-32|favicon-64|index\\.html|README\\.txt|robots\\.txt|styles\\.css|README\\.md|script\\.js|og-image|_vercel|package|sitemap|README|robots|script|styles|CNAME|index|api)(?:[/.]|$)).+)",
      "destination": "/",
      "permanent": true
    }
  ]
}
